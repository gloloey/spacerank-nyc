{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "app.py",
          "matching.py",
          "semantic.py",
          "landlord.py",
          "spaces_clean.csv",
          "index.html",
          "static/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "index.py" }]
}
